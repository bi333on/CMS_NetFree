# NetFree — конфигурация Apache / общий хостинг (веб-корень = корень проекта).
#
# Если веб-корень указывает на public/, этот файл не нужен — используйте
# настройки сервера. Если веб-корень = корень проекта, файл:
#   1) закрывает доступ к чувствительным каталогам/файлам;
#   2) направляет все остальные запросы на корневой index.php (мост в public/).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Закрываем доступ к ядру, конфигам и официальным плагинам.
    RewriteRule ^(app|config|storage|plugins|private-admin|core-assets)(/|$) - [F,L]

    # Закрываем чувствительные файлы в корне.
    RewriteRule ^(composer\.json|composer\.lock|Caddyfile|nginx\.conf|\.gitignore|\.env)$ - [F,L]

    # 2) Все запросы (кроме реально существующих файлов) — на фронт-контроллер.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Закрываем прямой доступ к файлам с чувствительными расширениями.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(env|ini|log|sql)$">
        Require all denied
    </FilesMatch>
</IfModule>
